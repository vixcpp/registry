          "commentLine": "//",
          "defaultSource": "#include <iostream>\n\nint main()\n{\n  int value = 42;\n  int* pointer = &value;\n\n  std::cout << *pointer << '\\n';\n  return 0;\n}\n",
          "executable": true,
          "id": "ptrlens",
          "label": "C++ Memory",
          "language": "cpp",
          "placeholder": "Write C++ code to visualize its memory."
        }
      ]
    }
